DATABASE_URL="postgresql://greenhub:greenhub@localhost:5432/greenhub?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
REDIS_URL="redis://localhost:6379"

# S3-совместимое хранилище (локально — MinIO из docker-compose, в проде — Yandex Object Storage)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_ORIGINALS="greenhub-originals"
S3_BUCKET_PROCESSED="greenhub-processed"
S3_PUBLIC_URL="http://localhost:9000"
