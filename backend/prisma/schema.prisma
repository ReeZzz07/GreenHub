generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли согласно TZ.md, раздел 3 (гость не хранится — это неавторизованный пользователь)
enum UserRole {
  BUYER
  SELLER_INDIVIDUAL
  SELLER_BUSINESS
  MODERATOR
  ADMIN
}

// Смена email — чувствительная операция (это же логин), поэтому не применяется сразу:
// новое значение ждёт в pendingEmail до одобрения модератором/админом (см. UsersService).
enum UserVerificationStatus {
  VERIFIED
  PENDING_MODERATION
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  passwordHash       String
  name               String
  phone              String?
  avatarUrl          String?
  pendingEmail       String?
  verificationStatus UserVerificationStatus  @default(VERIFIED)
  rejectionReason    String?
  role               UserRole                @default(BUYER)
  consentToDataProcessingAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  listings           Listing[]

  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messages              Message[]
  favorites             Favorite[]
  orders                Order[]
  reviewsWritten        Review[]       @relation("ReviewsWritten")
  reviewsReceived       Review[]       @relation("ReviewsReceived")
  notifications         Notification[]
}

enum CategoryIconType {
  EMOJI
  PRESET
  UPLOAD
}

model Category {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  icon      String?
  iconType  CategoryIconType @default(EMOJI)
  parentId  String?
  parent    Category?  @relation("CategoryToSubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToSubcategories")
  listings  Listing[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Статусы согласно TZ.md, раздел 5.2 (сценарий модерации)
enum ListingStatus {
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  SOLD
}

model Listing {
  id                String        @id @default(uuid())
  title             String
  latinName         String?
  description       String
  price             Int
  quantity          Int           @default(1)
  images            String[]
  videos            String[]      @default([])
  lightRequirements String?
  waterRequirements String?
  careInstructions  String[]
  deliveryInfo      String? // Регионы/способы доставки текстом — TZ.md 5.3.2 (MVP: без структурированных полей)
  status            ListingStatus @default(PENDING_MODERATION)
  rejectionReason   String?
  views             Int           @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  conversations Conversation[]
  favoritedBy   Favorite[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, categoryId])
}

model Favorite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

// Ключи внешних интеграций (ЮKassa, Plant.id, LLM), заполняются только администратором через /admin/settings.
// Значения никогда не отдаются обратно в API — только статус "настроено/нет" (см. SettingsController).
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Редактируемые тексты главной страницы (баннеры, "Почему GreenHub", "Как это работает" и т.д.) —
// одна строка-синглтон с фиксированным id, правится администратором через /admin/home-content.
model HomePageContent {
  id        String   @id
  content   Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Один чат на пару (покупатель, объявление) — сообщения продавцу пишутся в контексте конкретного товара
model Conversation {
  id String @id @default(uuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerConversations", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerConversations", fields: [sellerId], references: [id])

  messages Message[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  @@unique([listingId, buyerId])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// TZ.md, раздел 5.3: разовая платёжная ссылка на конкретное объявление (не многокорзинный чекаут)
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

model Order {
  id     String @id @default(uuid())
  amount Int
  quantity Int @default(1)
  status OrderStatus @default(PENDING)

  paymentUrl String?
  paymentId  String? @unique

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Отзыв покупателя о продавце, привязан к оплаченной сделке (один отзыв на заказ).
// Продавец может один раз ответить (sellerReply) — как в отзывах на Avito.
model Review {
  id          String  @id @default(uuid())
  rating      Int
  comment     String?
  sellerReply String?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  reviewerId String
  reviewer   User   @relation("ReviewsWritten", fields: [reviewerId], references: [id])

  sellerId String
  seller   User   @relation("ReviewsReceived", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  ORDER_PAID
  ORDER_CANCELLED
  NEW_REVIEW
  REVIEW_REPLY
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  link    String?
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
